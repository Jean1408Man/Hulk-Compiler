//falsos negativos
type Point(x: Number, y: Number) {
    x: Number = x;
    y: Number = y;
    getX(): Number => self.x;
    getY(): Number => self.y;
}

type PolarPoint inherits Point {
    rho(): Number => sqrt(self.getX() ^ 2 + self.getY() ^ 2);
}

type A {
    f(): Number => 1;
}

type B inherits A {
    f(): Number => base();
}

{
    let p = new PolarPoint(3, 4) in p.rho();

    new B().f();
}
