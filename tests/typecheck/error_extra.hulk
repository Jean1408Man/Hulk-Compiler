//falsos positivos
function f(x): Number => x + 1;

type A {
    f(x: Number): Number => x;
}

type Point {
    x: Number = 0;
}

function inc(x) => x + 1;

{
    print(f("hola"));

    let a = new A() in
        a.f("hola");

    let p = new Point() in
        print(p.x);

    let x: Number = 1 in {
        x := "hola";
        x + 1;
    };

    print(inc(5));
    print(inc("hola"));

    let x = 5 in
        x as String;
}
