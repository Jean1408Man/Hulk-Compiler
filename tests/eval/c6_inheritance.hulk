type Animal(name: String) {
    name: String = name;
    get_name(): String => self.name;
    speak() => print("...");
}

type Dog(name) inherits Animal(name) {
    speak() => print("Woof! Soy " @ self.get_name());
}

type Cat(name) inherits Animal(name) {
    speak() => print("Miau! Soy " @ self.get_name());
}

{
    let d = new Dog("Rex") in d.speak();
    let c = new Cat("Mishi") in c.speak();

    // is: verificar tipo en runtime desde un tipo estatico comun
    let a: Animal = new Dog("Buddy") in {
        print(a is Dog);
        print(a is Animal);
        print(a is Cat);
    };
}
