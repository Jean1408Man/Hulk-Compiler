// Test ok_01: declaraciones válidas y referencias resueltas
// Esperado: análisis semántico OK, 1 función y 2 tipos registrados

function greet(name: String): String => "Hola " @ name;

type Animal(name: String) {
    name: String = name;
    get_name(): String => self.name;
    speak() => print("...");
}

type Dog(name) inherits Animal(name) {
    speak() => print("Woof! I am " @ self.get_name());
}

{
    let d = new Dog("Rex") in d.speak();
    print(greet("mundo"));
}
