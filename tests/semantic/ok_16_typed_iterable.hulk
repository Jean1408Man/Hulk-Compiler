type Counter(max: Number) {
    i = 0;
    limit = max;

    next(): Boolean => {
        self.i := self.i + 1;
        self.i <= self.limit;
    };

    current(): Number => self.i;
}

function sum(values: Number*): Number =>
    let total = 0 in {
        for (x in values) total := total + x;
        total;
    };

sum(new Counter(3));
