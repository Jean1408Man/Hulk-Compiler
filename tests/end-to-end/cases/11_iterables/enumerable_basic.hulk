type CountIter(limit: Number) {
    i: Number = -1;
    limit: Number = limit;
    next(): Boolean => (self.i := self.i + 1) < self.limit;
    current(): Number => self.i;
}
type Counter(n: Number) {
    n: Number = n;
    iter(): Iterable => new CountIter(self.n);
}
{
    let c = new Counter(3) in {
        for (x in c.iter()) print(x);
        for (x in c.iter()) print(x);
    }
}
